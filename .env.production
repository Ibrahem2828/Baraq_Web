# Production environment defaults. Committed intentionally — every value
# here is a public-facing host or a non-secret feature flag, never a secret
# (real secrets, if any are ever needed, belong in `.env.production.local` on
# the deploy target only, which is gitignored and never committed — see
# docs/ENVIRONMENTS.md).
#
# Next.js loads `.env.local` before `.env.production` in every environment
# except `test`, so on this development machine `.env.local`
# (BACKEND_API_URL=http://localhost:8000) still wins and nothing here takes
# effect locally. This file only takes effect on a real deploy target, where
# no `.env.local` is present. That is deliberate: this file prepares
# production configuration without pointing any local run at the real
# backend. See scripts/validate-env.mjs for the gate that enforces this file
# is well-formed (HTTPS-only, no localhost, staging/production never mixed).

# --- App environment -------------------------------------------------------
APP_ENV=production

# --- Backend (server-only — NEVER prefix with NEXT_PUBLIC_) -----------------
# The real Baraq Django backend. No trailing slash, no /api/v1 suffix (the
# API client adds that automatically — see src/lib/api/backend.ts).
BACKEND_API_URL=https://api.baraqapp.com
BACKEND_API_TIMEOUT_MS=20000

# Unset here on purpose: src/config/env.ts defaults AUTH_COOKIE_SECURE to
# `true` whenever APP_ENV=production, and AUTH_COOKIE_DOMAIN to a host-only
# cookie (safer default unless a specific subdomain-sharing need is
# confirmed with the platform/infra team).
AUTH_COOKIE_SECURE=
AUTH_COOKIE_DOMAIN=

# Where the password-reset email link should point — this web app's own
# reset-password page on the real production domain.
FRONTEND_PASSWORD_RESET_URL=https://baraqapp.com/ar/reset-password

# Optional error monitoring. Left blank: no Sentry project/DSN has been
# provisioned yet — wiring this is a separate, explicit step, not implied by
# this file.
SENTRY_DSN=

# --- Public (client-safe — NEXT_PUBLIC_ prefix required to reach the browser) ---
NEXT_PUBLIC_APP_NAME=برّاق
NEXT_PUBLIC_SITE_URL=https://baraqapp.com
NEXT_PUBLIC_DEFAULT_LOCALE=ar
NEXT_PUBLIC_APP_VERSION=0.1.0

# Feature flags — mirror the mobile app's current production rollout state.
# Kholasa/Sada stay "coming soon" until product confirms the web app should
# launch these ahead of mobile (see src/config/characters.ts).
NEXT_PUBLIC_FEATURE_KHOLASA=false
NEXT_PUBLIC_FEATURE_SADA=false

# Account deletion and subscription checkout have no backend contract at
# all (re-verified in Phase 3 — see docs/FEATURE_PARITY_MATRIX.md). These
# env vars exist in the schema but are deliberately NOT read by
# src/config/feature-flags.ts, which hard-codes both to `false` regardless
# of env, so a misconfigured deploy can never advertise a feature with no
# working API behind it. Left unset here to avoid implying otherwise.
