# Copy to .env.local for development. Never commit the real file.
# See docs/WEB_ARCHITECTURE.md and docs/AUTH_SECURITY.md for what each value does.

# --- App environment -------------------------------------------------------
# development | staging | production — controls cookie `secure` default,
# BACKEND_API_URL safety checks (see scripts/validate-env.mjs), and log verbosity.
APP_ENV=development

# --- Backend (server-only — NEVER prefix with NEXT_PUBLIC_) -----------------
# The Django backend's origin, no trailing slash, no /api/v1 suffix (added
# automatically). Local dev: point at your local backend or a shared dev
# instance. Staging/production: must be HTTPS, never localhost.
BACKEND_API_URL=http://localhost:8000
BACKEND_API_TIMEOUT_MS=20000

# Auth cookie flags — leave AUTH_COOKIE_SECURE unset to default to
# `true` in production / `false` otherwise. Override only if you know why.
AUTH_COOKIE_SECURE=
AUTH_COOKIE_DOMAIN=

# Where the password-reset email link should point. The backend currently
# defaults this to a mobile deep link (`baraq://reset-password`) — set this
# to this web app's own reset-password page so emailed links open here.
FRONTEND_PASSWORD_RESET_URL=http://localhost:3000/ar/reset-password

# Optional error monitoring (Sentry or compatible). Leave blank to disable.
SENTRY_DSN=

# --- Public (client-safe — NEXT_PUBLIC_ prefix required to reach the browser) ---
NEXT_PUBLIC_APP_NAME=برّاق
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=ar
NEXT_PUBLIC_APP_VERSION=0.1.0

# Feature flags — mirror the mobile app's rollout state. See
# src/config/feature-flags.ts for the two flags that are hard-coded off
# (account deletion, subscription checkout) because no backend contract
# exists for them yet.
NEXT_PUBLIC_FEATURE_KHOLASA=false
NEXT_PUBLIC_FEATURE_SADA=false
